{
  "name": "@gabrielfins/liquid-glass",
  "version": "0.1.1",
  "description": "A liquid glass effect for any element, set with a data attribute: backdrop blur, edge distortion and a soft inner glow. No dependencies.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielfins/liquid-glass.git"
  },
  "keywords": [
    "liquid glass",
    "glassmorphism",
    "backdrop-filter",
    "blur",
    "svg filter",
    "displacement map",
    "css",
    "javascript",
    "typescript"
  ],
  "author": {
    "name": "Gabriel Figueredo",
    "email": "contato.gabrielfins@gmail.com"
  },
  "bugs": {
    "url": "https://github.com/gabrielfins/liquid-glass/issues"
  },
  "homepage": "https://gabrielfins.github.io/liquid-glass/",
  "type": "module",
  "sideEffects": [
    "./dist/index.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "docs:build": "vite build",
    "build": "tsup",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0"
  }
}
